{
  "name": "story-generator",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.9.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run && vitest run --config vitest.speed.config.ts",
    "test:browser": "playwright test",
    "bios": "node scripts/biographies.mjs",
    "drama": "node scripts/drama.mjs",
    "sweep": "node scripts/sweep.mjs",
    "worldmap": "node scripts/worldmap.mjs",
    "site": "node scripts/site.mjs",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "format:changed": "node scripts/format-changed.mjs",
    "check": "npm run format:changed && npm run typecheck && npm run boundaries && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
